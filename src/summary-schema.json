{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trunk Analytics CLI summary",
  "description": "What `upload` and `test` write to `--summary-output-file`, and the RSpec gem to `TRUNK_SUMMARY_OUTPUT_FILE`.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "Goes up when a change could break a reader, such as renaming or removing a field.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "The run finished and summarized its tests.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "UPLOAD"
        }
      },
      "$ref": "#/$defs/UploadReport",
      "required": ["type"]
    },
    {
      "description": "The run failed before it could summarize any tests.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ERROR"
        }
      },
      "$ref": "#/$defs/ErrorSummary",
      "required": ["type"]
    }
  ],
  "required": ["schemaVersion"],
  "$defs": {
    "ErrorKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["OTHER"]
        },
        {
          "description": "Couldn't connect to Trunk.",
          "type": "string",
          "const": "CONNECTION_REFUSED"
        },
        {
          "description": "Trunk rejected the org slug or token.",
          "type": "string",
          "const": "UNAUTHORIZED"
        },
        {
          "description": "The repo root couldn't be opened as a git repository.",
          "type": "string",
          "const": "GIT_REPOSITORY"
        },
        {
          "description": "The run stopped early, such as when it found no test reports and empty results aren't allowed.",
          "type": "string",
          "const": "INTERRUPTED"
        }
      ]
    },
    "ErrorSummary": {
      "type": "object",
      "properties": {
        "causes": {
          "description": "The errors that led to it, outermost first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "description": "The error, without its causes.",
          "type": "string"
        },
        "exitCode": {
          "description": "A run that fails outright exits with this code, or 0 when it's null. Upload reports exit with their own `exitCode`.",
          "type": ["integer", "null"],
          "format": "int32"
        },
        "explanation": {
          "description": "Trunk's explanation, when its API gave one.",
          "type": ["string", "null"]
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "message": {
          "description": "What the CLI was doing when the error happened.",
          "type": ["string", "null"]
        },
        "settingsUrl": {
          "description": "Where to check the org slug and token. Only set for `UNAUTHORIZED` errors.",
          "type": ["string", "null"]
        }
      },
      "required": [
        "kind",
        "message",
        "error",
        "causes",
        "explanation",
        "settingsUrl",
        "exitCode"
      ]
    },
    "FailedTest": {
      "type": "object",
      "properties": {
        "className": {
          "type": ["string", "null"]
        },
        "failureMessage": {
          "description": "The full message, which can be long.",
          "type": ["string", "null"]
        },
        "file": {
          "type": ["string", "null"]
        },
        "id": {
          "description": "Trunk's ID for the test.",
          "type": "string"
        },
        "link": {
          "description": "The test's page in Trunk.",
          "type": ["string", "null"]
        },
        "name": {
          "type": "string"
        },
        "quarantined": {
          "type": "boolean"
        },
        "suite": {
          "description": "Empty when the test has no suite.",
          "type": "string"
        },
        "variant": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "name",
        "suite",
        "className",
        "file",
        "id",
        "variant",
        "failureMessage",
        "quarantined",
        "link"
      ]
    },
    "FailureGroup": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/GroupKey"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FailedTest"
          }
        }
      },
      "required": ["key", "tests"]
    },
    "FileValidation": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": "string"
        },
        "parseError": {
          "description": "Why the file couldn't be parsed. `errors` and `warnings` are empty when this is set.",
          "type": ["string", "null"]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["file", "parseError", "errors", "warnings"]
    },
    "GroupKey": {
      "oneOf": [
        {
          "description": "Failed tests from this file.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "FILE"
            }
          },
          "required": ["type", "name"]
        },
        {
          "description": "Failed tests from this suite that have no file.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "SUITE"
            }
          },
          "required": ["type", "name"]
        },
        {
          "description": "Failed tests with neither a file nor a suite.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "OTHER"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "Notice": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/NoticeKind"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["kind", "message"]
    },
    "NoticeKind": {
      "oneOf": [
        {
          "description": "A deprecated flag was passed.",
          "type": "string",
          "const": "DEPRECATION"
        },
        {
          "description": "Part of the Bazel BEP file couldn't be parsed.",
          "type": "string",
          "const": "BEP_PARSE_ERROR"
        }
      ]
    },
    "Outcome": {
      "oneOf": [
        {
          "description": "The test reports had no tests.",
          "type": "string",
          "const": "NO_TESTS_FOUND"
        },
        {
          "description": "Every failed test was quarantined, so none of them fail the run.",
          "type": "string",
          "const": "ALL_FAILURES_QUARANTINED"
        },
        {
          "description": "No tests failed.",
          "type": "string",
          "const": "NO_FAILURES"
        },
        {
          "description": "No tests failed, but the test run's exit code wasn't 0, so some tests may not have run.",
          "type": "string",
          "const": "NO_FAILURES_BUT_NON_ZERO_EXIT_CODE"
        },
        {
          "description": "Some failed tests weren't quarantined.",
          "type": "string",
          "const": "FAILURES_NOT_QUARANTINED"
        }
      ]
    },
    "Quarantining": {
      "description": "Whether the failed tests could be checked for quarantining, and if not, why.",
      "oneOf": [
        {
          "description": "Trunk said which failed tests are quarantined.",
          "type": "string",
          "const": "CHECKED"
        },
        {
          "description": "Nothing needed looking up: no test failed, or the results already said which are quarantined.",
          "type": "string",
          "const": "NOT_NEEDED"
        },
        {
          "description": "Turned off for this run with `--disable-quarantining`.",
          "type": "string",
          "const": "DISABLED_VIA_CLI"
        },
        {
          "description": "Turned off for the repo in Trunk.",
          "type": "string",
          "const": "DISABLED_VIA_API"
        },
        {
          "description": "Trunk couldn't say which tests are quarantined, so no failed test counts as quarantined.",
          "type": "string",
          "const": "LOOKUP_FAILED"
        }
      ]
    },
    "TestCounts": {
      "type": "object",
      "properties": {
        "failed": {
          "description": "Failed tests that weren't quarantined.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "passRatio": {
          "description": "`passed / total`, from 0 to 1. Null when there are no tests.",
          "type": ["number", "null"],
          "format": "double"
        },
        "passed": {
          "description": "Tests that neither failed nor were quarantined.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "quarantined": {
          "description": "Failed tests that were quarantined.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": ["total", "passed", "failed", "quarantined", "passRatio"]
    },
    "UploadReport": {
      "type": "object",
      "properties": {
        "bundleUploadId": {
          "type": ["string", "null"]
        },
        "counts": {
          "$ref": "#/$defs/TestCounts"
        },
        "dryRun": {
          "description": "Nothing was uploaded (`--dry-run`), so there's no upload ID or upload link.",
          "type": "boolean"
        },
        "error": {
          "description": "Why uploading the results failed. The tests are still summarized.",
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "description": "The code the CLI exits with. Left out by the RSpec gem, where RSpec decides the exit code.",
          "type": ["integer", "null"],
          "format": "int32"
        },
        "failures": {
          "description": "Failed tests that weren't quarantined, grouped by file, else by suite.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FailureGroup"
          }
        },
        "notices": {
          "description": "Warnings that didn't stop the run, such as a deprecated flag.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notice"
          }
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "quarantined": {
          "description": "Failed tests that were quarantined, grouped like `failures`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FailureGroup"
          }
        },
        "quarantining": {
          "$ref": "#/$defs/Quarantining"
        },
        "uploadUrl": {
          "description": "This upload's page in Trunk. Only set for uploads to a test collection.",
          "type": ["string", "null"]
        },
        "validations": {
          "description": "One entry per test report file.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileValidation"
          }
        }
      },
      "required": [
        "error",
        "dryRun",
        "bundleUploadId",
        "uploadUrl",
        "validations",
        "counts",
        "quarantining",
        "quarantined",
        "failures",
        "outcome",
        "notices"
      ]
    }
  }
}
